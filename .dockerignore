# ROS / colcon artifacts (do NOT bake into images)
build/
install/
log/

# Python
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Training / runtime outputs (keep them out of the image)
models/
checkpoints/
multi_robot_checkpoints/
runs/
logs/
MUJOCO_LOG.TXT
nn_exports/

# VCS + editor
.git/
.gitignore
.github/
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

# Archives / big binaries
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.iso

# Nested training outputs (patterns above only match the repo root)
**/runs/
**/parallel_training/
**/*.pt
**/*.npz
**/*.ckpt
# ...but keep the camera calibration the SAM3 nodes load
!src/stretch_ros2/senior_project/senior_project/camera_calib.npz

# Plan / agent scratch
.superpowers/
