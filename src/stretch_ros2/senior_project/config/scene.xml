    <geom name="wall_w" type="box" pos="-5 0 0.5" size="0.1 5 0.5" rgba="0.6 0.58 0.55 1"/>

    <!-- ========== TARGET: Blue cylinder on small table, ~4m ahead (+x) ========== -->
    <!-- Table -->
    <body name="target_table" pos="4 0 0">
      <geom name="table_top" type="box" pos="0 0 0.45" size="0.35 0.35 0.03" rgba="0.45 0.35 0.25 1"/>
