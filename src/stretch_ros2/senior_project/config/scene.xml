      <geom name="blue_target" type="cylinder" pos="0 0 0.63" size="0.08 0.15" rgba="0.15 0.35 0.85 1"/>
    </body>

    <!-- ========== Obstacle furniture (replaces humans) ========== -->

    <!-- Bookshelf (where human_1 was, shifted slightly) -->
    <body name="bookshelf" pos="-2 3 0">
      <geom name="shelf_back" type="box" pos="0 0.15 0.6" size="0.5 0.05 0.6" rgba="0.50 0.32 0.18 1"/>
