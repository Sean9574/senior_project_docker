      <geom name="stool_leg1" type="cylinder" pos="0.12 0.12 0.2" size="0.02 0.2" rgba="0.35 0.35 0.35 1"/>
      <geom name="stool_leg2" type="cylinder" pos="-0.12 0.12 0.2" size="0.02 0.2" rgba="0.35 0.35 0.35 1"/>
      <geom name="stool_leg3" type="cylinder" pos="0.12 -0.12 0.2" size="0.02 0.2" rgba="0.35 0.35 0.35 1"/>
      <geom name="stool_leg4" type="cylinder" pos="-0.12 -0.12 0.2" size="0.02 0.2" rgba="0.35 0.35 0.35 1"/>
